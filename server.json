{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.fyipedia/distancefyi",
  "description": "Pure Python distance engine — Haversine great-circle distance, bearing, midpoint, travel time",
  "version": "0.1.3",
  "repository": {
    "url": "https://github.com/fyipedia/distancefyi",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "pypi",
      "registryBaseUrl": "https://pypi.org",
      "identifier": "distancefyi",
      "version": "0.1.3",
      "runtimeHint": "uvx",
      "transport": {
        "type": "stdio"
      },
      "runtimeArguments": [
        {
          "type": "named",
          "name": "--from",
          "value": "distancefyi[mcp]"
        },
        {
          "type": "positional",
          "value": "python"
        },
        {
          "type": "positional",
          "value": "-m"
        },
        {
          "type": "positional",
          "value": "distancefyi.mcp_server"
        }
      ]
    }
  ]
}
